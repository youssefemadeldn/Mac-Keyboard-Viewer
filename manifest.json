{
  "manifest_version": 3,
  "name": "Mac Keyboard Viewer",
  "short_name": "Keyboard Viewer",
  "version": "0.1.0",
  "description": "On-screen reference of macOS keyboard layouts, captured from real keypresses on your own Mac.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Mac Keyboard Viewer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
